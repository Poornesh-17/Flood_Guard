{
  "version": 8,
  "name": "FloodWatch Offline OSM",
  "sources": {
    "shortbread": {
      "type": "vector",
      "tiles": [
        "http://127.0.0.1/offline/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F2EFE9"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "land",
      "paint": {
        "fill-color": "#E8E4D8"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "water_polygons",
      "paint": {
        "fill-color": "#AAD3DF"
      }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "ocean",
      "paint": {
        "fill-color": "#AAD3DF"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "shortbread",
      "source-layer": "water_lines",
      "paint": {
        "line-color": "#78B8CC",
        "line-width": 1.5
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "shortbread",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#9A718F",
        "line-width": 1
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "filter": [
        "in",
        "kind",
        "motorway",
        "trunk",
        "primary",
        "secondary"
      ],
      "paint": {
        "line-color": "#F2B76B",
        "line-width": 2
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": 1
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "buildings",
      "paint": {
        "fill-color": "#D9D0C9"
      }
    },

    {
      "id": "place-labels",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "place_labels",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          9,
          7,
          12,
          10,
          14,
          14,
          16
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      }
    },

    {
      "id": "street-labels",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "street_labels",
      "minzoom": 10,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          8,
          12,
          10,
          14,
          12
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },

    {
      "id": "street-labels-points",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "street_labels_points",
      "minzoom": 12,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "text-size": 10,
        "text-font": [
          "Open Sans Regular"
        ]
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },

    {
      "id": "water-line-labels",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "water_lines_labels",
      "minzoom": 8,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": 10,
        "text-font": [
          "Open Sans Regular"
        ]
      },
      "paint": {
        "text-color": "#3D7F95",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },

    {
      "id": "water-polygon-labels",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "water_polygons_labels",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": 10,
        "text-font": [
          "Open Sans Regular"
        ]
      },
      "paint": {
        "text-color": "#3D7F95",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },

    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "pois",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": 9,
        "text-font": [
          "Open Sans Regular"
        ],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    }
  ]
}